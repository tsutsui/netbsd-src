Section "Files"
    ModulePath "/usr/X11R6/lib/modules"
    FontPath "/usr/X11R6/lib/X11/fonts/misc/"
EndSection
Section "Module"
    Load "xf1bpp"
    Load "fb"
    Load "shadow"
EndSection
Section "InputDevice"
    Identifier "Keyboard0"
    Driver "keyboard"
    Option "Protocol" "standard"
    Option "XkbRules" "xfree86"
    Option "XkbModel" "pc105"
    Option "XkbLayout" "jp"
EndSection
Section "InputDevice"
    Identifier "Mouse0"
    Driver "mouse"
    Option "Protocol" "wsmouse"
    Option "Device" "/dev/wsmouse0"
    Option "Buttons" "3"
EndSection
Section "Device"
    Identifier "LunaMono"
    Driver "wsfb"
    Option "Device" "/dev/ttyE0"
    Option "ShadowFB" "false"
EndSection
Section "Monitor"
    Identifier "LunaMonitor"
EndSection
Section "Screen"
    Identifier "Screen0"
    Device "LunaMono"
    Monitor "LunaMonitor"
    DefaultDepth 1
    SubSection "Display"
        Depth 1
    EndSubSection
EndSection
Section "ServerLayout"
    Identifier "LunaLayout"
    Screen "Screen0"
    InputDevice "Keyboard0" "CoreKeyboard"
    InputDevice "Mouse0" "CorePointer"
EndSection
